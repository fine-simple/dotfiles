" Enable yntax highlighting and file type detection
syntax on
filetype plugin indent on

" Set the default tab width and indentation
set tabstop=2
set shiftwidth=2
set expandtab

" Enable line numbers
set number

" Enable relative line numbers
set relativenumber

" Highlight the current line
set cursorline

" Enable mouse support
set mouse=a

" Enable persistent undo
set undofile

" Enable clipboard support
set clipboard=unnamedplus

" Enable incremental search
set incsearch
set ignorecase
set smartcase


